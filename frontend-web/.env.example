# Copy to .env.local (never commit secrets: every VITE_* value is public in the browser bundle).

# Development only. Lets you open /student, /merchant and /admin without signing in. Stripped from production builds.
VITE_DEV_BYPASS_AUTH=false

# Optional: restrict student sign-up to these e-mail domains (comma separated). Empty = any valid e-mail.
VITE_STUDENT_EMAIL_DOMAINS=
