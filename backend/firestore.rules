rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // Rôles : etudiant | commercant (validé) | commercant_en_attente | association | admin
    // TOUTES les écritures passent par les Cloud Functions (Admin SDK ignore ces règles).

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /commercants/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /associations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Offres : lecture pour tout utilisateur connecté ;
    // création / modification / suppression via creerOffre, modifierOffre, supprimerOffre.
    match /offres/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /commandes/{id} {
      allow read: if signedIn() && (resource.data.etudiantId == request.auth.uid
                  || resource.data.commercantId == request.auth.uid
                  || isAdmin());
      allow write: if false;
    }

    match /paiements/{id} {
      allow read: if signedIn() && (resource.data.etudiantId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /qrcodes/{id} {
      allow read: if signedIn() && resource.data.etudiantId == request.auth.uid;
      allow write: if false;
    }

    match /feedbacks/{id} {
      allow read: if signedIn();
      allow write: if false; // via soumettreFeedback
    }

    match /commandesGroupees/{id} {
      allow read: if signedIn();
      allow write: if false; // via envoyerDemandeGroupee / accepterOuRefuserProposition
    }

    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /suggestionsIA/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
